{
  "manifest_version": 3,
  "name": "SpotDock Bridge",
  "version": "2.0.0",
  "description": "Feeds the current Spotify Web track to the SpotDock taskbar widget.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "alarms",
    "scripting",
    "tabs"
  ],
  "background": {
    "service_worker": "sw.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://open.spotify.com/*"
      ],
      "all_frames": false,
      "run_at": "document_idle",
      "js": [
        "content.js"
      ]
    }
  ],
  "host_permissions": [
    "https://open.spotify.com/*"
  ]
}
